# Shell scripts must stay LF. This repository is checked out on both Windows and Linux,
# and a CRLF script fails on Linux with a bare "\r: command not found".
*.sh text eol=lf

# Notebooks are JSON. Treat them as text but never rewrite line endings, so diffs stay
# meaningful and the file hash is stable across platforms.
*.ipynb -text

# Model artifacts, should any ever be force-added.
*.pt binary
*.pth binary
*.npy binary
*.npz binary
